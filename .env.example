APP_NAME=Agentic RAG
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_BIND=127.0.0.1
APP_PORT=8000
IMAGE_TAG=local
PYTHON_VERSION=3.11
# Formato LangChain provider:model; configure antes de usar agentic-rag-ask.
LLM_MODEL=
# Adapter incluido na imagem rag; pode ser trocado por outro pacote LangChain.
LLM_PROVIDER_PACKAGE=langchain-openai==1.5.1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
CHROMA_MODE=http
CHROMA_COLLECTION=knowledge
CHROMA_PATH=./chroma
CHROMA_HOST=localhost
CHROMA_BIND=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_IMAGE=chromadb/chroma:1.5.9
INGESTION_CHUNK_SIZE=700
INGESTION_CHUNK_OVERLAP=100
RAG_FETCH_K=60
RAG_CANDIDATE_K=20
RAG_FINAL_K=5
RAG_LAMBDA_MULT=0.65
MAX_RAG_ATTEMPTS=2
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_TIMEOUT_SECONDS=10
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
