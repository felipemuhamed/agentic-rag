APP_NAME=Agentic RAG
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false
APP_BIND=127.0.0.1
APP_PORT=8000
IMAGE_TAG=local
PYTHON_VERSION=3.11
# Formato LangChain provider:model; configure antes de usar o RAG.
LLM_MODEL=openrouter:anthropic/claude-sonnet-4.6
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# Adapter incluido nas imagens api/rag; pode ser trocado no build.
LLM_PROVIDER_PACKAGE=langchain-openrouter==0.2.8
# Nunca grave uma chave real neste arquivo; use somente o .env ignorado pelo Git.
OPENROUTER_API_KEY=
VISION_MODEL=
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_IMAGES=1
MULTIMODAL_MAX_IMAGE_BYTES=5000000
VISUAL_CATALOG_ENABLED=true
VISUAL_COLLECTION=equipment_images
VISUAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
VISUAL_EMBEDDING_DEVICE=cpu
VISUAL_MAX_RESULTS=3
# Calibre com imagens reais: distância menor representa maior similaridade.
VISUAL_MAX_DISTANCE=0.35
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
CHROMA_MODE=http
CHROMA_COLLECTION=knowledge
CHROMA_PATH=./chroma
CHROMA_HOST=localhost
CHROMA_BIND=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_IMAGE=chromadb/chroma:1.5.9
INGESTION_CHUNK_SIZE=700
INGESTION_CHUNK_OVERLAP=100
# Upload de documentos pela API; no Compose o diretorio vira o volume upload-data.
UPLOAD_ENABLED=true
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=20000000
UPLOAD_WORKERS=1
UPLOAD_MAX_PENDING_JOBS=32
UPLOAD_MAX_JOBS=200
UPLOAD_JOB_RETENTION_SECONDS=3600
RAG_FETCH_K=60
RAG_CANDIDATE_K=20
RAG_FINAL_K=5
RAG_LAMBDA_MULT=0.65
MAX_RAG_ATTEMPTS=2
CHECKPOINTER_MODE=sqlite
CHECKPOINTER_PATH=./data/checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true
AUTH_ENABLED=false
# JSON: [{"key":"replace-with-a-random-key-32-chars","principal":"frontend","tenants":["public"]}]
API_KEY_POLICIES=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_STREAMS=4
METRICS_ENABLED=true
METRICS_API_KEY=
STREAM_MAX_DURATION_SECONDS=120
# Carrega embedder, reranker e CLIP no startup; /ready so abre depois.
WARMUP_ON_STARTUP=true

# --- Langfuse (observabilidade de LLM, self-hosted) ---------------------------
# A stack sobe com o profile 'observability' e o app funciona sem ela.
LANGFUSE_ENABLED=false
# Dentro do Compose use o nome do servico; fora dele, http://localhost:3000.
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Estas duas chaves sao usadas em dois papeis: o app autentica com elas e o
# servidor as cadastra no primeiro boot (headless init). Prefixos exigidos.
LANGFUSE_PUBLIC_KEY=lf_pk_troque_este_valor
LANGFUSE_SECRET_KEY=lf_sk_troque_este_valor
# Segredos do servidor. Sem eles o Langfuse nao sobe.
#   openssl rand -base64 32  -> SALT e NEXTAUTH_SECRET
#   openssl rand -hex 32     -> ENCRYPTION_KEY (256 bits, 64 caracteres hex)
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=
# URL pela qual o navegador acessa a UI.
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_BIND=127.0.0.1
LANGFUSE_PORT=3000
LANGFUSE_MINIO_PORT=9090
LANGFUSE_MINIO_PUBLIC_ENDPOINT=http://localhost:9090
# Primeiro usuario criado no boot inicial; deixe vazio para criar pela UI.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# Senhas da infraestrutura interna do Langfuse.
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
LANGFUSE_REDIS_PASSWORD=langfuse
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_TELEMETRY_ENABLED=false

# --- Monitoracao ao vivo via MCP (Zabbix) -----------------------------------
# Quando ligado, perguntas sobre alarmes consultam o servidor MCP antes de
# buscar nos manuais. Desligado, o pipeline responde so pela documentacao.
MONITORING_ENABLED=false
MONITORING_MCP_URL=http://zabbix-mcp:8080/mcp
MONITORING_MCP_TOKEN=
# Allowlist: SOMENTE estas ferramentas chegam ao modelo. Descubra os nomes
# reais com `agentic-rag-monitoring-tools`. Vazio = nenhuma ferramenta.
MONITORING_ALLOWED_TOOLS=
MONITORING_MAX_ITERATIONS=3
MONITORING_TIMEOUT_SECONDS=30
# Demonstracao sem um Zabbix por perto: `scripts/ambiente.sh zabbix-falso`
# sobe um servidor MCP de mentira com dados inventados. Para usa-lo:
#   MONITORING_ENABLED=true
#   MONITORING_MCP_URL=http://zabbix-falso:8080/mcp
#   MONITORING_ALLOWED_TOOLS=problem_get,trigger_get,host_get
ZABBIX_FALSO_BIND=127.0.0.1
ZABBIX_FALSO_PORT=8080
# Peso do identificador lido por OCR contra a similaridade visual.
EQUIPMENT_IDENTIFIER_WEIGHT=0.65
# Abaixo desta confianca o agente se abstem em vez de filtrar manuais.
EQUIPMENT_MIN_CONFIDENCE=0.55
# Dois candidatos dentro desta margem sao tratados como ambiguos.
EQUIPMENT_AMBIGUITY_MARGIN=0.08
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_TIMEOUT_SECONDS=10
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=false
TAVILY_BASE_URL=https://api.tavily.com
EXTERNAL_MAX_ATTEMPTS=3
EXTERNAL_BACKOFF_SECONDS=0.25
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30
KNOWLEDGE_TENANT_ID=
MONITORING_ENABLED=true
MONITORING_MCP_URL=http://zabbix-falso:8080/mcp
MONITORING_ALLOWED_TOOLS=problem_get,trigger_get,host_get